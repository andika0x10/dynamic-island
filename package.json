{
  "name": "dynamic-island",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Dynamic Island activity overlay for Windows",
  "author": "Andika",
  "scripts": {
    "dev": "npm run build && npm start",
    "dev:web": "vite",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build && node scripts/build-host.mjs",
    "build:native": "node scripts/build-host.mjs",
    "start": "node scripts/start.mjs",
    "pack": "npm run build && node scripts/stage-host.mjs",
    "pack:msix": "npm run pack && pwsh -NoLogo -NoProfile -File scripts/package-msix.ps1",
    "test": "node --test tests/*.test.ts",
    "test:native": "node scripts/smoke-webview.mjs",
    "test:smoke": "node scripts/smoke-webview.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "dist:win": "npm run pack && electron-builder --win nsis zip --x64 --prepackaged release/webview-unpacked --publish never"
  },
  "build": {
    "appId": "com.andika.dynamicisland",
    "productName": "Dynamic Island",
    "directories": {
      "output": "release"
    },
    "win": {
      "signAndEditExecutable": false
    },
    "nsis": {
      "differentialPackage": false,
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Dynamic-Island-${version}-${arch}-setup.${ext}",
      "include": "packaging/installer.nsh",
      "packElevateHelper": false
    },
    "artifactName": "Dynamic-Island-${version}-${arch}.${ext}",
    "electronVersion": "45.0.0"
  },
  "dependencies": {
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.88.0",
    "playwright": "^1.64.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
